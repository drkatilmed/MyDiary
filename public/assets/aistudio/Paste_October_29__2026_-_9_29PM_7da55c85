function handlePhotoFilesList(files) {
  if (!files || !files.length) return;
  const remainingSlots = 10 - attachedPhotos.length;
  if (remainingSlots <= 0) {
    showToast('Maksimum 10 keping gambar sahaja dibenarkan!');
    return;
  }

  const filesToProcess = files.slice(0, remainingSlots);
  if (files.length > remainingSlots) {
    showToast(`Hanya ${remainingSlots} foto dimasukkan (had 10).`);
  }
  let processedCount = 0;

  filesToProcess.forEach(file => {
    const reader = new FileReader();
    reader.onload = (event) => {
      compressImage(event.target.result, 800, 0.85, (compressedBase64) => {
        attachedPhotos.push(compressedBase64);
        processedCount++;
        if (processedCount === filesToProcess.length) {
          currentPhotoCursorIndex = attachedPhotos.length - 1;
          updatePhotoDropdownUI();
          showToast(`${processedCount} foto berjaya dimasukkan!`);
        }
      });
    };
    reader.onerror = () => {
      processedCount++;
      if (processedCount === filesToProcess.length) updatePhotoDropdownUI();
    };
    reader.readAsDataURL(file);
  });
}

function compressImage(base64Str, maxSide, quality, callback) {
  const img = new Image();
  img.onload = () => {
    let width = img.width;
    let height = img.height;
    if (width > height) {
      if (width > maxSide) {
        height = Math.round((height * maxSide) / width);
        width = maxSide;
      }
    } else {
      if (height > maxSide) {
        width = Math.round((width * maxSide) / height);
        height = maxSide;
      }
    }
    const canvas = document.createElement('canvas');
    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    ctx.drawImage(img, 0, 0, width, height);
    callback(canvas.toDataURL('image/jpeg', quality));
  };
  img.onerror = () => callback(base64Str);
  img.src = base64Str;
}

