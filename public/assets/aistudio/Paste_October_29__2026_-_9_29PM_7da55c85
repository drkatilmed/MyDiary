/* ---------- WAKTU SOLAT ---------- */
let currentPrayerTimes = null;
let prayerCountdownInterval = null;

function initPrayerTimes() {
  if (prayerLiveBadge) {
    prayerLiveBadge.addEventListener('click', () => {
      showToast('Mengemas kini lokasi solat...');
      fetchDeviceCoordinates();
    });
  }
  fetchDeviceCoordinates();
}

function fetchDeviceCoordinates() {
  if (!navigator.geolocation) {
    fetchPrayerTimesByCoords(3.1390, 101.6869, 'K.Lumpur');
    return;
  }

  navigator.geolocation.getCurrentPosition(
    (position) => {
      fetchPrayerTimesByCoords(position.coords.latitude, position.coords.longitude, 'Lokasi Anda');
    },
    () => {
      fetchPrayerTimesByCoords(3.1390, 101.6869, 'K.Lumpur (Lalai)');
    },
    { timeout: 10000, enableHighAccuracy: false }
  );
}

async function fetchPrayerTimesByCoords(lat, lng, locationLabel) {
  try {
    const timestamp = Math.floor(Date.now() / 1000);
    // method=17 : JAKIM (Malaysia)
    const response = await fetch(`https://api.aladhan.com/v1/timings/${timestamp}?latitude=${lat}&longitude=${lng}&method=17`);

    if (!response.ok) throw new Error('API solat tidak dapat dihubungi');
    const json = await response.json();

    if (json && json.data && json.data.timings) {
      currentPrayerTimes = json.data.timings;
      updateNextPrayer(locationLabel);

      if (prayerCountdownInterval) clearInterval(prayerCountdownInterval);
      prayerCountdownInterval = setInterval(() => {
        updateNextPrayer(locationLabel);
      }, 30000);
    } else {
      throw new Error('Data solat tidak sah');
    }
  } catch (err) {
    calculateLocalEstimatedPrayer(locationLabel);
  }
}

function calculateLocalEstimatedPrayer(label) {
  currentPrayerTimes = {
    Fajr: "05:48",
    Sunrise: "07:00",
    Dhuhr: "13:08",
    Asr: "16:25",
    Maghrib: "19:10",
    Isha: "20:20"
  };
  updateNextPrayer(label + ' • anggaran');

  if (prayerCountdownInterval) clearInterval(prayerCountdownInterval);
  prayerCountdownInterval = setInterval(() => {
    updateNextPrayer(label + ' • anggaran');
  }, 30000);
}

function parsePrayerTimeToDate(timeStr) {
  const cleanTime = String(timeStr).split(' ')[0];
  const [h, m] = cleanTime.split(':').map(Number);
  const d = new Date();
  d.setHours(h, m, 0, 0);
  return d;
}

function updateNextPrayer(locationLabel) {
  if (!currentPrayerTimes || !nextPrayerName || !nextPrayerTime) return;

  const now = new Date();
  const prayerList = [
    { key: 'Fajr', label: 'Subuh' },
    { key: 'Sunrise', label: 'Syuruk' },
    { key: 'Dhuhr', label: 'Zohor' },
    { key: 'Asr', label: 'Asar' },
    { key: 'Maghrib', label: 'Maghrib' },
    { key: 'Isha', label: 'Isyak' }
  ];

  let upcomingPrayer = null;
  let upcomingDate = null;

  for (let i = 0; i < prayerList.length; i++) {
    const p = prayerList[i];
    if (currentPrayerTimes[p.key]) {
      const pDate = parsePrayerTimeToDate(currentPrayerTimes[p.key]);
      if (pDate > now) {
        upcomingPrayer = p;
        upcomingDate = pDate;
        break;
      }
    }
  }

  if (!upcomingPrayer) {
    upcomingPrayer = prayerList[0];
    upcomingDate = parsePrayerTimeToDate(currentPrayerTimes.Fajr);
    upcomingDate.setDate(upcomingDate.getDate() + 1);
  }

  nextPrayerName.textContent = upcomingPrayer.label;
  const cleanClockTime = (currentPrayerTimes[upcomingPrayer.key] || '--:--').split(' ')[0];
  nextPrayerTime.textContent = cleanClockTime;

  const diffMs = upcomingDate.getTime() - now.getTime();
  const diffMinsTotal = Math.max(1, Math.floor(diffMs / 60000));
  const diffHours = Math.floor(diffMinsTotal / 60);
  const diffMins = diffMinsTotal % 60;

  let countdownStr = '';
  if (diffHours > 0) {
    countdownStr = `${diffHours}j ${diffMins}m lagi (${locationLabel})`;
  } else {
    countdownStr = `${diffMins} min lagi (${locationLabel})`;
  }

  if (prayerCountdownDesc) prayerCountdownDesc.textContent = countdownStr;
}

/* ---------- HABUK EMAS ---------- */
function initGoldenDust() {
  if (!dustCanvas) return;
  const ctx = dustCanvas.getContext('2d');
  let particles = [];
  let width = dustCanvas.width = window.innerWidth;
  let height = dustCanvas.height = window.innerHeight;

  window.addEventListener('resize', () => {
    width = dustCanvas.width = window.innerWidth;
    height = dustCanvas.height = window.innerHeight;
  });

  const particleCount = 45;
  for (let i = 0; i < particleCount; i++) {
    particles.push({
      x: Math.random() * width,
      y: Math.random() * height,
      size: Math.random() * 2.2 + 0.8,
      speedY: Math.random() * -0.4 - 0.15,
      speedX: (Math.random() - 0.5) * 0.3,
      opacity: Math.random() * 0.7 + 0.2,
      pulse: Math.random() * 0.02
    });
  }

  function renderDust() {
    ctx.clearRect(0, 0, width, height);
    const t = Date.now() * 0.002;
    particles.forEach(p => {
      p.y += p.speedY;
      p.x += p.speedX;
      p.opacity += Math.sin(t) * p.pulse;

      if (p.y < -10) { p.y = height + 10; p.x = Math.random() * width; }
      if (p.x < -10) p.x = width + 10;
      if (p.x > width + 10) p.x = -10;

      ctx.beginPath();
      ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(255, 215, 0, ${Math.max(0.1, Math.min(0.85, p.opacity))})`;
      ctx.shadowBlur = 8;
      ctx.shadowColor = 'rgba(255, 215, 0, 0.7)';
      ctx.fill();
    });
    requestAnimationFrame(renderDust);
  }
  renderDust();
}

