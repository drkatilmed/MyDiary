async function startCameraStream(facing) {
  try {
    if (cameraMediaStream) {
      cameraMediaStream.getTracks().forEach(track => track.stop());
      cameraMediaStream = null;
    }

    if (cameraStatusSubtitle) cameraStatusSubtitle.textContent = 'Menyambung lensa kamera...';

    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      throw new Error('MediaDevices tidak disokong.');
    }

    const constraintsList = [
      { video: { facingMode: { ideal: facing }, width: { ideal: 640 }, height: { ideal: 640 } }, audio: false },
      { video: { facingMode: facing }, audio: false },
      { video: true, audio: false }
    ];

    let streamObtained = null;
    let lastErr = null;
    for (const c of constraintsList) {
      try {
        streamObtained = await navigator.mediaDevices.getUserMedia(c);
        if (streamObtained) break;
      } catch (e) {
        lastErr = e;
        if (e && e.name === 'NotAllowedError') break; // kebenaran ditolak, tak perlu cuba lagi
      }
    }

    if (!streamObtained) throw (lastErr || new Error('Akses kamera disekat.'));

    // Jika modal sudah ditutup semasa menunggu kebenaran, lepaskan kamera
    if (!cameraModal.classList.contains('active')) {
      streamObtained.getTracks().forEach(t => t.stop());
      return;
    }

    cameraMediaStream = streamObtained;
    cameraVideo.srcObject = cameraMediaStream;
    cameraVideo.muted = true;
    cameraVideo.setAttribute('playsinline', '');
    cameraVideo.setAttribute('webkit-playsinline', '');

    await cameraVideo.play();
    if (cameraStatusSubtitle) cameraStatusSubtitle.textContent = facing === 'environment' ? 'Kamera Belakang Aktif' : 'Kamera Depan Aktif';
  } catch (err) {
    if (cameraStatusSubtitle) {
      let reason = 'Lensa kamera tidak dapat dibuka.';
      if (!window.isSecureContext) {
        reason = 'Kamera memerlukan HTTPS (atau localhost). Fail yang dibuka terus (file://) tidak dibenarkan.';
      } else if (err && err.name === 'NotAllowedError') {
        reason = 'Kebenaran kamera ditolak. Benarkan kamera di tetapan pelayar/aplikasi.';
      } else if (err && err.name === 'NotFoundError') {
        reason = 'Tiada kamera dikesan pada peranti ini.';
      } else if (err && err.name === 'NotReadableError') {
        reason = 'Kamera sedang digunakan oleh aplikasi lain.';
      }
      cameraStatusSubtitle.innerHTML = escapeHtml(reason) + '<br><button type="button" onclick="triggerNativeCameraAndCloseModal()" style="margin-top:6px; background:var(--accent-color); color:#fff; border:none; padding:4px 10px; border-radius:6px; font-weight:700; cursor:pointer;">Guna Kamera Telefon (Ambil Foto)</button>';
    }
  }
}

