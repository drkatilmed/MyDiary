  journalEntryForm.addEventListener('submit', (e) => {
    e.preventDefault();

    if (currentEditingEntryId) {
      const updatedEntry = createEntryObject(currentEditingEntryId);
      if (!updatedEntry) return;

      const index = journalEntries.findIndex(item => item.id === currentEditingEntryId);
      if (index !== -1) {
        journalEntries[index] = updatedEntry;
        saveEntriesToStorage();
        renderEntries();
        renderCalendar();
        resetEditorForm();
        showToast('Catatan berjaya dikemas kini!');
        openArchiveDropside();
      }
    } else {
      const newEntry = createEntryObject();
      if (!newEntry) return;

      journalEntries.unshift(newEntry);
      saveEntriesToStorage();
      renderEntries();
      renderCalendar();
      resetEditorForm();

      const isFuture = new Date(newEntry.timestamp).getTime() > Date.now();
      showToast(isFuture ? 'Perancangan masa depan berjaya disimpan!' : 'Catatan berjaya disimpan ke arkib!');
      openArchiveDropside();
    }
  });
}

/* ---------- GOOGLE CALENDAR ---------- */
function buildGoogleCalendarLink(entry) {
  const startDate = new Date(entry.timestamp);
  const endDate = new Date(startDate.getTime() + 60 * 60 * 1000);

  const formatGCal = (d) => d.toISOString().replace(/-|:|\.\d\d\d/g, "");
  const datesParam = `${formatGCal(startDate)}/${formatGCal(endDate)}`;
  const titleText = `[MyDiary] ${entry.title}`;
  const isFuture = startDate.getTime() > Date.now();
  const detailsText = `Status: ${isFuture ? 'Perancangan Masa Depan' : 'Catatan Jurnal'}\nKategori: ${entry.category}\nSuasana: ${entry.mood}\n\nNota:\n${entry.content}`;

  const baseUrl = "https://calendar.google.com/calendar/render";
  const params = new URLSearchParams({
    action: "TEMPLATE",
    text: titleText,
    dates: datesParam,
    details: detailsText
  });

  return `${baseUrl}?${params.toString()}`;
}

if (saveAndGoogleCalendarBtn) {
  saveAndGoogleCalendarBtn.addEventListener('click', () => {
    const entryToSave = createEntryObject(currentEditingEntryId);
    if (!entryToSave) return;

    if (currentEditingEntryId) {
      const index = journalEntries.findIndex(item => item.id === currentEditingEntryId);
      if (index !== -1) journalEntries[index] = entryToSave;
      else journalEntries.unshift(entryToSave);
    } else {
      journalEntries.unshift(entryToSave);
    }

    saveEntriesToStorage();
    renderEntries();
    renderCalendar();

    const gcalUrl = buildGoogleCalendarLink(entryToSave);
    window.open(gcalUrl, '_blank');

    resetEditorForm();
    showToast('Disimpan & dialihkan ke Google Calendar!');
    openArchiveDropside();
  });
}

/* ---------- PAPARAN ARKIB ---------- */
function renderEntries(searchTerm = '') {
  if (!archiveEntriesContainer) return;
  archiveEntriesContainer.innerHTML = '';

  let list = [...journalEntries];

  if (searchTerm.trim()) {
    const q = searchTerm.toLowerCase();
    list = list.filter(e =>
      (e.title || '').toLowerCase().includes(q) ||
      (e.content || '').toLowerCase().includes(q)
    );
  }

  if (currentFilteredDate) {
    list = list.filter(e => toDateKey(new Date(e.timestamp)) === currentFilteredDate);
  }

  // Susun mengikut tarikh catatan (terkini di atas)
  list.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

  if (list.length === 0) {
    archiveEntriesContainer.innerHTML = '<div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted); font-size: 0.85rem;"><i class="fa-regular fa-folder-open" style="font-size: 2rem; margin-bottom: 0.5rem; display: block; opacity: 0.5;"></i>Tiada catatan ditemui.</div>';
    return;
  }

  list.forEach(entry => {
    const card = document.createElement('article');
    card.className = 'entry-card';

    const dateObj = new Date(entry.timestamp);
    const isFuture = dateObj.getTime() > Date.now();
    const dateStr = dateObj.toLocaleDateString('ms-MY', { day: 'numeric', month: 'short', year: 'numeric' });
    const timeStr = dateObj.toLocaleTimeString('ms-MY', { hour: '2-digit', minute: '2-digit' });

    let photoThumbnailsHtml = '';
    if (entry.photos && entry.photos.length > 0) {
      const imgsHtml = entry.photos.map((p, i) =>
        `<img class="entry-thumb" data-photo-index="${i}" src="${p}" alt="Foto" style="width: 48px; height: 48px; object-fit: cover; border-radius: 4px; cursor: pointer; border: 1px solid var(--border-color);">`
      ).join('');
      photoThumbnailsHtml = `<div style="display: flex; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.35rem;">${imgsHtml}</div>`;
    }

    let audioPlayHtml = '';
    if (entry.audios && entry.audios.some(a => a !== null)) {
      const audios = entry.audios
        .filter(a => a !== null)
        .map(a => `<audio controls src="${a}" style="width: 100%; height: 28px; margin-top: 0.25rem;"></audio>`)
        .join('');
      audioPlayHtml = `<div style="margin-top: 0.35rem;">${audios}</div>`;
    }

    const futureBadge = isFuture
      ? '<span class="filter-badge" style="background:#3b82f6; color:#fff; font-size:0.65rem;"><i class="fa-solid fa-rocket"></i> Masa Depan</span>'
      : '';

    card.innerHTML = `
      <div class="entry-card-header">
        <div>
          <div style="display: flex; align-items: center; gap: 0.4rem; flex-wrap: wrap;">
            <h4 class="entry-title">${escapeHtml(entry.title)}</h4>
            ${futureBadge}
          </div>
          <div class="entry-meta-info">
            <span><i class="fa-regular fa-calendar"></i> ${dateStr}</span>
            <span><i class="fa-regular fa-clock"></i> ${timeStr}</span>
          </div>
        </div>
        <span style="font-size: 0.85rem;">${escapeHtml(entry.mood)}</span>
      </div>

      <p class="entry-body">${escapeHtml(entry.content)}</p>

      ${photoThumbnailsHtml}
      ${audioPlayHtml}

      <div class="entry-footer">
        <span class="filter-badge" style="background: var(--accent-soft); color: var(--accent-color);">#${escapeHtml(entry.category)}</span>
        <div style="display: flex; gap: 0.35rem;">
          <button type="button" class="action-btn-sm edit" data-action="edit" title="Sunting Semula Catatan Ini">
            <i class="fa-solid fa-pen-to-square"></i>
          </button>
          <button type="button" class="action-btn-sm" data-action="gcal" title="Buka di Google Calendar">
            <i class="fa-brands fa-google" style="color: #4285f4;"></i>
          </button>
          <button type="button" class="action-btn-sm delete" data-action="delete" title="Padam Catatan">
            <i class="fa-solid fa-trash"></i>
          </button>
        </div>
      </div>
    `;

    // Pasang pendengar acara (lebih selamat daripada onclick sebaris)
    card.querySelectorAll('.entry-thumb').forEach(img => {
      img.addEventListener('click', () => zoomImage(img.src));
    });
    card.querySelector('[data-action="edit"]').addEventListener('click', () => startEditEntryRecord(entry.id));
    card.querySelector('[data-action="gcal"]').addEventListener('click', () => exportEntryToGCal(entry.id));
    card.querySelector('[data-action="delete"]').addEventListener('click', () => deleteEntryRecord(entry.id));

    archiveEntriesContainer.appendChild(card);
  });
}

window.deleteEntryRecord = function (id) {
  if (!confirm('Padam catatan ini secara kekal?')) return;
  journalEntries = journalEntries.filter(e => e.id !== id);
  if (currentEditingEntryId === id) resetEditorForm();
  saveEntriesToStorage();
  renderEntries(searchEntriesInput ? searchEntriesInput.value : '');
  renderCalendar();
  showToast('Catatan dipadam daripada arkib.');
};

window.exportEntryToGCal = function (id) {
  const entry = journalEntries.find(e => e.id === id);
  if (!entry) return;
  window.open(buildGoogleCalendarLink(entry), '_blank');
};

function openArchiveDropside() {
  archiveDropside.classList.add('open');
  archiveBackdrop.classList.add('open');
  renderEntries(searchEntriesInput ? searchEntriesInput.value : '');
}

function closeArchiveDropside() {
  archiveDropside.classList.remove('open');
  archiveBackdrop.classList.remove('open');
}

function setupEventListeners() {
  if (headerArchiveBtn) headerArchiveBtn.addEventListener('click', openArchiveDropside);
  if (floatingArchiveBtn) floatingArchiveBtn.addEventListener('click', openArchiveDropside);
  if (closeArchiveBtn) closeArchiveBtn.addEventListener('click', closeArchiveDropside);
  if (archiveBackdrop) archiveBackdrop.addEventListener('click', closeArchiveDropside);

  const joyMascot = document.getElementById('joyMascot');
  const happyEmojis = ['😄', '🥳', '✨', '💃', '🌟', '🥰', '🎈', '🤩'];
  if (joyMascot) {
    joyMascot.addEventListener('click', () => {
      const rand = happyEmojis[Math.floor(Math.random() * happyEmojis.length)];
      joyMascot.textContent = rand;
      showToast('Keep smiling & stay happy! ' + rand);
    });
  }

  if (searchEntriesInput) {
    searchEntriesInput.addEventListener('input', (e) => {
      renderEntries(e.target.value);
    });
  }

  if (themeBtnToggle) {
    themeBtnToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      themeDropdownMenu.classList.toggle('active');
    });
  }
  document.addEventListener('click', (e) => {
    if (themeDropdownMenu && !themeBtnToggle.contains(e.target) && !themeDropdownMenu.contains(e.target)) {
      themeDropdownMenu.classList.remove('active');
    }
  });

  if (openDonateModalBtn) {
    openDonateModalBtn.addEventListener('click', () => donateModal.classList.add('active'));
  }
  if (closeDonateModalBtn) {
    closeDonateModalBtn.addEventListener('click', () => donateModal.classList.remove('active'));
  }
  if (donateModal) {
    donateModal.addEventListener('click', (e) => {
      if (e.target === donateModal) donateModal.classList.remove('active');
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeArchiveDropside();
      if (cameraModal) stopCameraStream();
      if (donateModal) donateModal.classList.remove('active');
      const zoom = document.getElementById('imageZoomModal');
      if (zoom) zoom.classList.remove('active');
    }
  });
}

/* ---------- NAVIGASI BELAKANG (butang Back / gesture swipe) ----------
   Back/swipe tidak akan keluar aplikasi: ia menutup lapisan terbuka
   (zum foto, kamera, derma, arkib, menu tema), atau kembali ke menu utama. */
function closeTopLayer() {
  const zoom = document.getElementById('imageZoomModal');
  if (zoom && zoom.classList.contains('active')) { zoom.classList.remove('active'); return true; }
  if (cameraModal && cameraModal.classList.contains('active')) { stopCameraStream(); return true; }
  if (donateModal && donateModal.classList.contains('active')) { donateModal.classList.remove('active'); return true; }
  if (archiveDropside && archiveDropside.classList.contains('open')) { closeArchiveDropside(); return true; }
  if (themeDropdownMenu && themeDropdownMenu.classList.contains('active')) { themeDropdownMenu.classList.remove('active'); return true; }
  return false;
}

function goHomeMenu() {
  if (currentFilteredDate) {
    currentFilteredDate = null;
    if (resetCalFilterBtn) resetCalFilterBtn.style.display = 'none';
    renderCalendar();
    renderEntries(searchEntriesInput ? searchEntriesInput.value : '');
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function pushGuardState() {
  try { history.pushState({ page: 'guard' }, '', location.href); } catch (e) {}
}

function initBackNavigation() {
  try {
    history.replaceState({ page: 'home' }, '', location.href);
  } catch (e) { return; }
  pushGuardState();

  window.addEventListener('popstate', () => {
    if (!closeTopLayer()) goHomeMenu();
    pushGuardState(); // kekal dalam aplikasi
  });

  // Pelayar sesetengahnya mengabaikan entri sejarah tanpa interaksi pengguna,
  // jadi pastikan pengawal wujud selepas sentuhan pertama.
  const ensureGuard = () => {
    try {
      if (!history.state || history.state.page !== 'guard') pushGuardState();
    } catch (e) {}
  };
  document.addEventListener('pointerdown', ensureGuard, { passive: true });
}

window.zoomImage = function (src) {
  const modal = document.getElementById('imageZoomModal');
  const img = document.getElementById('zoomedImageTag');
  if (modal && img && src) {
    img.src = src;
    modal.classList.add('active');
  }
};

let toastTimer = null;
function showToast(message) {
  if (!toastNotification || !toastMessageText) return;
  toastMessageText.textContent = message;
  toastNotification.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => {
    toastNotification.classList.remove('show');
  }, 3200);
}

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}
