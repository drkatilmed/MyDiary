/* getUserMedia dalam sesetengah WebView/APK tidak pernah selesai (tiada respons). Had masa menjamin UI sentiasa bertindak balas. */
function getMicStreamWithTimeout(ms) {
  return new Promise((resolve, reject) => {
    let settled = false;
    const timer = setTimeout(() => {
      if (settled) return;
      settled = true;
      const e = new Error('Tiada respons daripada mikrofon.');
      e.name = 'TimeoutError';
      reject(e);
    }, ms);
    navigator.mediaDevices.getUserMedia({ audio: true }).then(stream => {
      if (settled) { stream.getTracks().forEach(t => t.stop()); return; }
      settled = true;
      clearTimeout(timer);
      resolve(stream);
    }).catch(err => {
      if (settled) return;
      settled = true;
      clearTimeout(timer);
      reject(err);
    });
  });
}

function getSupportedAudioMimeType() {
  const candidates = [
    'audio/mp4',
    'audio/webm;codecs=opus',
    'audio/webm',
    'audio/aac',
    'audio/ogg'
  ];
  for (const t of candidates) {
    if (window.MediaRecorder && MediaRecorder.isTypeSupported && MediaRecorder.isTypeSupported(t)) {
      return t;
    }
  }
  return '';
}

if (toggleRecordBtn) {
  toggleRecordBtn.addEventListener('click', async () => {
    if (!isRecording) {
      try {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia || !window.MediaRecorder) {
          throw new Error('Pelayar ini tidak menyokong rakaman audio.');
        }

        toggleRecordBtn.disabled = true;
        toggleRecordBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Menyambung mikrofon...';
        audioStream = await getMicStreamWithTimeout(8000);
        toggleRecordBtn.disabled = false;
        const mimeType = getSupportedAudioMimeType();
        const options = mimeType ? { mimeType } : {};
        const targetSlot = currentAudioSlotIndex; // slot dikunci semasa mula rakam

        try {
          mediaRecorder = new MediaRecorder(audioStream, options);
        } catch (e1) {
          mediaRecorder = new MediaRecorder(audioStream); // format lalai pelayar
        }
        audioChunks = [];

        mediaRecorder.ondataavailable = e => {
          if (e.data && e.data.size > 0) audioChunks.push(e.data);
        };

        mediaRecorder.onstop = () => {
          const audioBlob = new Blob(audioChunks, { type: (mediaRecorder && mediaRecorder.mimeType) || mimeType || 'audio/webm' });
          const reader = new FileReader();
          reader.onload = (e) => {
            attachedAudios[targetSlot] = e.target.result;
            updateAudioSlotUI();
            showToast(`Audio Slot ${targetSlot + 1} berjaya disimpan!`);
          };
          reader.readAsDataURL(audioBlob);

          if (audioStream) {
            audioStream.getTracks().forEach(track => track.stop());
            audioStream = null;
          }
        };

        mediaRecorder.start(250);
        isRecording = true;
        const errBox = document.getElementById('audioErrorMsg');
        if (errBox) errBox.style.display = 'none';
        toggleRecordBtn.classList.add('recording');
        toggleRecordBtn.innerHTML = '<i class="fa-solid fa-stop"></i> Berhenti Rakam';
        recordingTimer.style.display = 'inline-block';
        recordingSeconds = 0;
        recordingTimer.innerHTML = '<i class="fa-solid fa-circle"></i> 00:00';
        recordingInterval = setInterval(() => {
          recordingSeconds++;
          const mins = String(Math.floor(recordingSeconds / 60)).padStart(2, '0');
          const secs = String(recordingSeconds % 60).padStart(2, '0');
          recordingTimer.innerHTML = `<i class="fa-solid fa-circle"></i> ${mins}:${secs}`;
        }, 1000);

      } catch (err) {
        toggleRecordBtn.disabled = false;
        toggleRecordBtn.classList.remove('recording');
        toggleRecordBtn.innerHTML = '<i class="fa-solid fa-microphone"></i> Mula Rakam';
        let reason = 'Rakaman gagal dimulakan.';
        if (!window.isSecureContext) {
          reason = 'Mikrofon perlukan HTTPS (atau localhost).';
        } else if (err && err.name === 'NotAllowedError') {
          reason = 'Mikrofon disekat. Benarkan mikrofon untuk laman ini di tetapan pelayar (ikon di sebelah alamat URL).';
        } else if (err && err.name === 'NotFoundError') {
          reason = 'Tiada mikrofon dikesan.';
        } else if (err && err.name === 'TimeoutError') {
          reason = 'Tiada respons: WebView aplikasi ini tidak meluluskan akses mikrofon. Buka laman di Chrome, atau pembina APK perlu mengaktifkan kebenaran mikrofon WebView.';
        } else if (err && err.name === 'NotReadableError') {
          reason = 'Mikrofon sedang digunakan aplikasi lain.';
        } else if (err && err.message) {
          reason = err.message;
        }
        showToast(reason);
        const errBoxShow = document.getElementById('audioErrorMsg');
        if (errBoxShow) {
          errBoxShow.textContent = reason;
          errBoxShow.style.display = 'block';
        }
        if (audioStream) {
          audioStream.getTracks().forEach(t => t.stop());
          audioStream = null;
        }
      }
    } else {
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        mediaRecorder.stop();
      }
      isRecording = false;
      toggleRecordBtn.classList.remove('recording');
      toggleRecordBtn.innerHTML = '<i class="fa-solid fa-microphone"></i> Mula Rakam';
      recordingTimer.style.display = 'none';
      clearInterval(recordingInterval);
    }
  });
}

